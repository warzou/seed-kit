[Unit]
Description=Wifi-Kit normal UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/seed-kit-wifi-kit-preview
Environment=WIFI_KIT_ENABLE_PRIVILEGED_ACTIONS=1
Environment=WIFI_KIT_RUNTIME_CONFIG=%h/.config/wifi-kit/runtime.conf
Environment=WIFI_KIT_UI_PORT=54321
ExecStart=/usr/bin/python3 modules/wifi-kit/prototype/ui/serve-readonly.py --host 0.0.0.0 --port ${WIFI_KIT_UI_PORT}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
